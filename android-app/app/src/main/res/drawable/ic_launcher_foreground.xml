<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — a simple house glyph.

    All geometry sits inside the ~66dp "safe zone" circle centered on
    this 108x108 canvas (roughly x:21-87, y:21-87), so nothing gets
    clipped once the OS masks the icon into whatever shape the
    launcher uses (circle, squircle, rounded square, teardrop, ...).

    Kept to a single flat silhouette + one accent dot on purpose —
    Android also uses this same drawable, re-tinted to one flat
    color, for themed/monochrome launcher icons on Android 13+, so a
    busier illustration would lose most of its detail there anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- House silhouette -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 L74,46 L74,80 L34,80 L34,46 Z" />

    <!-- Door cutout, punched through in the background color -->
    <path
        android:fillColor="#0058CC"
        android:pathData="M47,80 L47,63 L61,63 L61,80 Z" />

    <!-- "Smart" status-light accent -->
    <path
        android:fillColor="#FFB800"
        android:pathData="M40,55 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />

</vector>
