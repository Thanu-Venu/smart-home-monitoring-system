<?xml version="1.0" encoding="utf-8"?>
<!--
    Standalone in-app brand mark (Login/Sign Up header, etc).

    Single tintable path — the door is a hole cut via evenOdd fill,
    not a second overlapping shape — so this renders correctly no
    matter what tint color Icon()/painterResource() applies to it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,4 L18,10 L18,20 L6,20 L6,10 Z M10,20 L10,14 L14,14 L14,20 Z" />

</vector>
